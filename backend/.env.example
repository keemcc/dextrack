# Get these from https://developer.dexcom.com after registering an app
# Use the SANDBOX credentials while developing - no approval needed for those
DEXCOM_CLIENT_ID=your_client_id_here
DEXCOM_CLIENT_SECRET=your_client_secret_here

# Must exactly match the redirect URI you registered on developer.dexcom.com
DEXCOM_REDIRECT_URI=http://localhost:4000/auth/callback

# Sandbox base URL. Switch to https://api.dexcom.com when you get production access
DEXCOM_API_BASE=https://sandbox-api.dexcom.com

# Port the backend runs on
PORT=4000

# USDA FoodData Central - get a free key at https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works for testing but has a low rate limit (shared by everyone using it)
USDA_API_KEY=DEMO_KEY

# Where the mobile app is allowed to call from (Expo dev server, adjust as needed)
CORS_ORIGIN=*
