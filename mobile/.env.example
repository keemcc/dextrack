# Copy to .env.local (Expo refuses to load REACT_NATIVE_PACKAGER_HOSTNAME
# from a plain .env) and fill in your values.

# Backend URL the app calls. With `tailscale serve --bg 4000` on the backend
# machine this is https://<machine>.<tailnet>.ts.net
EXPO_PUBLIC_API_URL=https://your-machine.your-tailnet.ts.net

# Host Expo puts in the QR code so phones load the bundle over the tailnet
REACT_NATIVE_PACKAGER_HOSTNAME=your-machine.your-tailnet.ts.net
